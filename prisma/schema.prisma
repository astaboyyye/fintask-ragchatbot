// Prisma schema for the RAG chatbot.
// pgvector columns are declared as Unsupported("vector(1536)"): Prisma can create
// them through migrations, and all reads/writes of embeddings go through raw SQL
// (see lib/vectorSearch.js and pages/api/process.js).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum DocStatus {
  UPLOADED // text extracted, waiting for chunk + embed
  PROCESSING // chunking / embedding in progress
  READY // chunks embedded and searchable
  FAILED
}

model Document {
  id             String        @id @default(cuid())
  ownerId        String // NextAuth user id, or an anonymous browser id cookie
  title          String
  fileName       String
  fileSize       Int
  contentHash    String? // SHA-256 of the PDF, to reuse embeddings on re-upload
  pageCount      Int
  charCount      Int
  pages          Json // string[]: extracted text for each page (1-indexed by position)
  status         DocStatus     @default(UPLOADED)
  error          String?
  chunkCount     Int           @default(0)
  tokenCount     Int           @default(0)
  embeddingModel String? // model that produced the stored vectors
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  chunks         Chunk[]
  messages       ChatMessage[]

  @@index([ownerId, createdAt])
  @@index([ownerId, contentHash])
}

model Chunk {
  id         String                       @id
  documentId String
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int
  content    String
  tokenCount Int
  pageStart  Int
  pageEnd    Int
  embedding  Unsupported("vector(1536)")?

  @@unique([documentId, index])
}

model ChatMessage {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role       String // "user" | "assistant"
  content    String
  sources    Json? // retrieved chunks used for an assistant answer
  model      String? // model that wrote an assistant answer
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}
