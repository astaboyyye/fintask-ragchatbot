{
  "name": "fintask-ragchatbot",
  "version": "1.0.0",
  "private": true,
  "description": "AI chatbot with document RAG: PDF upload, pgvector search, Claude answers with source citations",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "@prisma/client": "6.19.3",
    "formidable": "3.5.4",
    "js-tiktoken": "1.0.21",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "openai": "7.54.0",
    "pdf-parse": "2.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
